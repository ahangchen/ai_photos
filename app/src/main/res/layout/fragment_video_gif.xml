<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎬 视频转 GIF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Video preview area -->
        <ImageView
            android:id="@+id/ivVideoPreview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#1a1a1a"
            android:scaleType="centerCrop"
            android:contentDescription="视频预览"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnPickVideo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="选择视频"
            android:layout_marginBottom="24dp" />

        <!-- Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="帧率 (FPS)"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvFpsValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <SeekBar
                android:id="@+id/seekFps"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:max="14"
                android:progress="4" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="宽度 (px)"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvWidthValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="480"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <SeekBar
                android:id="@+id/seekWidth"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:max="6"
                android:progress="3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="时长限制 (秒)"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDurationValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全部"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <SeekBar
                android:id="@+id/seekDuration"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:max="30"
                android:progress="0" />
        </LinearLayout>

        <Button
            android:id="@+id/btnConvert"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="开始转换"
            android:textSize="16sp"
            android:enabled="false"
            android:layout_marginBottom="16dp" />

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#666"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Result -->
        <ImageView
            android:id="@+id/ivResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:maxHeight="300dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:layout_marginBottom="12dp"
            android:contentDescription="GIF 预览" />

        <TextView
            android:id="@+id/tvResultInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:alpha="0.7"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnShare"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="分享 GIF"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>
